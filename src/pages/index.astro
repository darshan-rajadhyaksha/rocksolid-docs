---
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="RockSolid"
  metaTitle="RockSolid - A Modern SolidJS Component Library",
  description="RockSolid is a SolidJS and Tailwind CSS component library for building modern, accessible, and consistent user interfaces with reusable, themeable components."
  url="/"
  type="website"
>
  <section
    class="mx-auto max-w-5xl py-15 text-neutral-900 dark:text-neutral-100 lg:py-20"
  >
    <!-- Hero -->
    <div class="max-w-3xl">
      <p
        class="mb-4 text-sm font-medium text-neutral-500 dark:text-neutral-400"
      >
        SolidJS component library
      </p>
      <h1 class="text-4xl text-balance font-semibold tracking-tight sm:text-5xl lg:text-6xl">
        Build modern interfaces with 
        <span class="text-neutral-900 font-extrabold dark:text-neutral-200"> RockSolid.</span>
      </h1>
      <p
        class="mt-6 max-w-2xl text-lg leading-8 text-neutral-600 dark:text-neutral-400"
      >
        RockSolid is a component library built with SolidJS and Tailwind CSS for
        building modern, consistent, and accessible user interfaces.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/installation/"
          class="no-underline rounded-md bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
        >
          Get started
        </a>
        <a
          href="/components/"
          class="no-underline rounded-md border border-neutral-200 bg-white px-4 py-2.5 text-sm font-medium text-neutral-700 transition hover:bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-900"
        >
          Explore components
        </a>
      </div>
    </div>

    <!-- Features -->
    <div class="mt-24 pt-16 dark:border-neutral-800">
      <div class="max-w-2xl">
        <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400">
          Why RockSolid?
        </p>
        <h2
          class="mt-3 border-0 text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100"
        >
          Everything you need to build consistent interfaces.
        </h2>

        <p
          class="mt-4 text-base leading-7 text-neutral-600 dark:text-neutral-400"
        >
          Reusable components, a consistent API, and a flexible theme system
          help you build applications faster without recreating common UI
          patterns.
        </p>
      </div>

      <div
        class="mt-12 grid overflow-hidden rounded-lg border border-neutral-200 bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-800 sm:grid-cols-2 lg:grid-cols-3"
      >
        <article class="bg-white p-6 dark:bg-neutral-950">
          <h3
            class="mt-4 text-md font-semibold text-neutral-900 dark:text-neutral-100"
          >
            SolidJS
          </h3>

          <p
            class="mt-0 text-sm leading-6 text-neutral-600 dark:text-neutral-400"
          >
            Built specifically for SolidJS applications with APIs designed for
            the SolidJS ecosystem.
          </p>
        </article>

        <article class="bg-white p-6 dark:bg-neutral-950">
          <h3
            class="mt-4 text-md font-semibold text-neutral-900 dark:text-neutral-100"
          >
            Tailwind CSS
          </h3>

          <p
            class="mt-0 text-sm leading-6 text-neutral-600 dark:text-neutral-400"
          >
            Use familiar Tailwind CSS utilities for flexible and predictable
            styling.
          </p>
        </article>

        <article class="bg-white p-6 dark:bg-neutral-950">
          <h3
            class="mt-4 text-md font-semibold text-neutral-900 dark:text-neutral-100"
          >
            Accessible
          </h3>

          <p
            class="mt-0 text-sm leading-6 text-neutral-600 dark:text-neutral-400"
          >
            Components consider keyboard interaction, focus management, semantic
            HTML, and ARIA support.
          </p>
        </article>

        <article class="bg-white p-6 dark:bg-neutral-950">
          <h3
            class="mt-4 text-md font-semibold text-neutral-900 dark:text-neutral-100"
          >
            TypeScript
          </h3>

          <p
            class="mt-0 text-sm leading-6 text-neutral-600 dark:text-neutral-400"
          >
            Get type safety and autocomplete across component APIs and theme
            configuration.
          </p>
        </article>

        <article class="bg-white p-6 dark:bg-neutral-950">
          <h3
            class="mt-4 text-md font-semibold text-neutral-900 dark:text-neutral-100"
          >
            Themeable
          </h3>

          <p
            class="mt-0 text-sm leading-6 text-neutral-600 dark:text-neutral-400"
          >
            Customize colors, typography, rounded corners, shadows, and other
            design tokens.
          </p>
        </article>

        <article class="bg-white p-6 dark:bg-neutral-950">
          <h3
            class="mt-4 text-md font-semibold text-neutral-900 dark:text-neutral-100"
          >
            Composable
          </h3>

          <p
            class="mt-0 text-sm leading-6 text-neutral-600 dark:text-neutral-400"
          >
            Combine components to create more complex interfaces while keeping
            your code reusable and maintainable.
          </p>
        </article>
      </div>
    </div>

    <!-- CTA -->
    <div
      class="mt-24 pt-8 dark:border-neutral-800"
    >
      <div
        class="flex flex-col gap-6 rounded-lg border border-neutral-200 bg-neutral-50 p-8 dark:border-neutral-800 dark:bg-neutral-900 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h2
            class="mt-4 text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100"
          >
            Start building with RockSolid.
          </h2>
          <p
            class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400"
          >
            Install RockSolid and start building with accessible, reusable
            components.
          </p>
        </div>
        <a
          href="/installation/"
          class="no-underline inline-flex shrink-0 items-center justify-center rounded-md bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
        >
          Read the installation guide
          <span class="ml-2">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
