---
import DynamicComponentRenderer from "@/components/dynamic-component-renderer";
import CodeBlock from "@/components/code-block.astro";
import Checkmark from "@/icons/checkmark";
import Copy from "@/icons/copy";

type Props = {
  name: string;
  lang?: string;
};

const { name, lang = "tsx" } = Astro.props as Props;

const sources = import.meta.glob("/src/docs/**/*.tsx", {
  eager: true,
  query: "?raw",
  import: "default",
});

const sourcePath = `/src/docs/${name}.tsx`;

const source = sources[sourcePath] as string | undefined;

const id = Math.random().toString(36).substring(2);

if (!source) {
  throw new Error(`Example source not found: ${sourcePath}`);
}
---

<div
  id={`compoent-example-${id}`}
  data-component-example
  class="my-8
    overflow-hidden
    rounded-xl
    border
    border-neutral-200
    bg-white
    dark:border-neutral-800
    dark:bg-neutral-950"
>
  <div
    class="flex
      justify-center
      items-center
      min-h-20
      bg-white
      p-5
      text-base
      text-neutral-900
      dark:bg-neutral-950
      dark:text-neutral-100"
    data-component-preview
  >
    <DynamicComponentRenderer name={name} client:only="solid-js" />
  </div>
  <div
    data-code
    class="border-t
      border-neutral-200
      dark:border-neutral-800"
  >
    <div class="relative">
      <button
        type="button"
        data-copy
        class="absolute
          top-3
          z-10
          ltr:right-3
          rtl:left-3
          rounded-md
          bg-neutral-200
          size-6
          text-xl
          grid
          place-items-center
          text-neutral-900
          transition-colors
          hover:bg-neutral-200/80
          dark:bg-neutral-700/90
          dark:text-white
          dark:hover:bg-neutral-700"
      >
        <Checkmark class="checkmark hidden" />
        <Copy class="copy" />
      </button>
      <CodeBlock code={source} lang={lang} />
    </div>
  </div>
</div>

<script define:vars={{ id, source }}>
  const copyBtn = document.querySelector(`#compoent-example-${id} [data-copy]`);
  copyBtn?.addEventListener("click", async () => {
    try {
      const copyIcon = copyBtn.querySelector(".copy");
      const checkmarkIcon = copyBtn.querySelector(".checkmark");
      await navigator.clipboard.writeText(source);
      copyIcon.classList.add("hidden");
      checkmarkIcon.classList.remove("hidden");
      copyBtn.disabled = true;
      setTimeout(() => {
        copyIcon.classList.remove("hidden");
        checkmarkIcon.classList.add("hidden");
        copyBtn.disabled = false;
      }, 2000);
    } catch (error) {
      console.error("failed to copy to clipboard");
    }
  });
</script>
